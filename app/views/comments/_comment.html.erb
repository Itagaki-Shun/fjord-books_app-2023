<h3><%= t('views.common.comment', name: Comment.model_name.human, count: @commentable.comments.count) %></h3>
<% @commentable.comments.each do |comment| %>
  <div class="comment-item">
    <div id="<%= dom_id comment %>">
      <div class="comment-header">
        <p>
          <%= comment.user&.display_name %>
        </p>
        <p>
          <%= l(comment.created_at, format: :long) %>
        </p>
      </div>

      <div class="comment-body">
        <p>
          <%= comment.content %>
        </p>
      </div>

      <% if comment.user == current_user %>
        <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), [@commentable, comment], method: :delete %>
      <% end %>
    </div>
  </div>
<% end %>
