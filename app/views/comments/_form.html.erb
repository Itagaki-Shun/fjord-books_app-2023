<div class="comment-form">
  <%= form_with model: [@commentable, Comment.new], local: true do |f| %>
    <div class="field">
      <%= f.label :content %>
      <%= f.text_area :content, required: true %>
    </div>

    <div class="comment-actions">
      <%= f.submit t('views.common.post', name: Comment.model_name.human) %>
    </div>
  <% end %>
</div>
