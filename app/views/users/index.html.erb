<div id="users" class="index-items">
  <% @users.each do |user| %>
    <div class="index-item">
      <%= render user %>
      <p>
        <%= link_to t('views.common.show', name: 'ユーザー'), user_path(user) %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('views.common.back', name: i18n_pluralize(Book.model_name.human.downcase)), books_path %>
  <%= link_to t('activerecord.models.user.profile'), mypage_path %>
</nav>
