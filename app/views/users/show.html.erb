<h1><%= t('activerecord.models.user.profile') %></h1>

<%= render @user %>

<nav class="page-nav">
  <% if current_user == @user %>
    <%= button_to t('devise.registrations.edit.title', resource: 'プロフィール'), edit_user_registration_path, method: :get %>
  <% end %>
  <%= link_to t('views.common.back', name: i18n_pluralize(Book.model_name.human.downcase)), books_path %> |
  <%= link_to t('views.common.title_index', name: 'ユーザー'), users_path, class: "btn btn-primary" %> |
  <%= link_to t('devise.sessions.destroy.logout'), destroy_user_session_path, data: { turbo_method: :delete } %>
</nav>
